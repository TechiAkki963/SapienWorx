# Local development placeholders only. Never commit production secrets.
APP_ENV=development
API_PORT=8080
DATABASE_URL=postgres://sapienworx:sapienworx_local@localhost:5432/sapienworx?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_OTP_HMAC_SECRET=replace-with-a-different-32-byte-random-secret
JWT_ISSUER=sapienworx-api
JWT_AUDIENCE=sapienworx-web
JWT_ACCESS_TOKEN_TTL=15m
JWT_CLOCK_SKEW=30s
AUTH_REFRESH_TOKEN_TTL=720h
AUTH_OTP_TTL=10m
AUTH_OTP_RESEND_INTERVAL=60s
AUTH_OTP_IP_LIMIT=8
AUTH_OTP_IP_WINDOW=10m
AUTH_LOGIN_IP_LIMIT=12
AUTH_LOGIN_IP_WINDOW=5m
# Bulk InMail recipient budgets. Company-wide daily limits must be >= recruiter daily limits.
INMAIL_BULK_RECRUITER_HOURLY_LIMIT=300
INMAIL_BULK_RECRUITER_DAILY_LIMIT=1000
INMAIL_BULK_COMPANY_DAILY_LIMIT=5000
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_ACCESS_COOKIE_NAME=sw_access
AUTH_REFRESH_COOKIE_NAME=sw_refresh
AUTH_CSRF_COOKIE_NAME=sw_csrf
CORS_ALLOWED_ORIGINS=http://localhost:3000
HTTP_READ_TIMEOUT=15s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_MAX_BODY_BYTES=2097152
# Micro-instance profile: keep the application pool small and let PostgreSQL retain memory for work/shared buffers.
DB_MAX_CONNS=6
DB_MIN_CONNS=0
DB_MAX_CONN_LIFETIME=20m
DB_MAX_CONN_IDLE_TIME=2m
DB_HEALTH_TIMEOUT=2s
AWS_REGION=ap-south-1
# AI Gateway foundation. Server only; downstream AI features remain OFF.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_ENABLED=false
OPENAI_DEFAULT_MODEL=
OPENAI_PARSER_MODEL=
OPENAI_GENERATION_MODEL=
# Separate injected base64 AES-256 key; never reuse the API/JWT/MFA key.
AI_ARTIFACT_ENCRYPTION_KEY=
# Optional model routes; empty values inherit the configured default.
AI_MODEL_DEFAULT=
AI_MODEL_CV_PARSER=
AI_MODEL_JD_GENERATOR=
AI_MODEL_SEARCH_QUERY=
AI_MODEL_MATCH_EXPLANATION=
AI_MODEL_FALLBACK=
AI_CV_PARSER_ENABLED=false
AI_JOB_PARSER_ENABLED=false
AI_JD_GENERATOR_ENABLED=false
AI_PROMPT_SEARCH_ENABLED=false
AI_MATCH_EXPLANATION_ENABLED=false
AI_REQUEST_TIMEOUT_SECONDS=20
# Per-attempt parsing deadlines; retries/backoff are also bounded by an operation deadline.
# Enabling a parsing route requires HTTP_WRITE_TIMEOUT to exceed its operation deadline.
AI_JOB_PARSE_TIMEOUT_SECONDS=20
AI_CV_PARSE_TIMEOUT_SECONDS=30
# Unmeasured generation/search tasks inherit AI_REQUEST_TIMEOUT_SECONDS unless configured.
AI_JD_GENERATE_TIMEOUT_SECONDS=
AI_SEARCH_PARSE_TIMEOUT_SECONDS=
AI_MAX_RETRIES=1
AI_MAX_INPUT_CHARS=32000
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_CONCURRENT_REQUESTS=2
AI_GLOBAL_REQUESTS_PER_MINUTE=30
AI_FEATURE_REQUESTS_PER_MINUTE=20
AI_TENANT_REQUESTS_PER_MINUTE=20
AI_USER_REQUESTS_PER_MINUTE=6
AI_GLOBAL_DAILY_REQUEST_LIMIT=1000
AI_USER_DAILY_REQUEST_LIMIT=100
AI_DAILY_BUDGET_USD=1
AI_MONTHLY_BUDGET_USD=10
AI_TENANT_DAILY_BUDGET_USD=0.1
AI_TENANT_MONTHLY_BUDGET_USD=2
AI_BUDGET_ALERT_FRACTION=0.8
# Operator-supplied USD rates per 1M tokens. Empty means explicitly unknown cost.
# Fields: input_usd_per_million, cached_input_usd_per_million, output_usd_per_million.
# Optional: cache_write_input_usd_per_million (required for known cost if writes occur).
AI_MODEL_PRICING_JSON=
S3_BUCKET=
S3_PRESIGN_TTL=5m
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_AUTH_CSRF_COOKIE_NAME=sw_csrf
