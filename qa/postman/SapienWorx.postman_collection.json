{
  "info": {
    "name": "SapienWorx API QA",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key":"baseUrl","value":"http://127.0.0.1:8080"},
    {"key":"recruiterJwt","value":""},
    {"key":"candidateJwt","value":""},
    {"key":"jobId","value":""},
    {"key":"applicationId","value":""}
  ],
  "item": [
    {
      "name":"Health",
      "item":[
        {"name":"Liveness","request":{"method":"GET","url":"{{baseUrl}}/health/live"},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));","pm.test('ok',()=>pm.expect(pm.response.json().status).to.eql('ok')); "]}}]},
        {"name":"Readiness","request":{"method":"GET","url":"{{baseUrl}}/health/ready"},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));","pm.test('ready',()=>pm.expect(pm.response.json().status).to.eql('ready')); "]}}]}
      ]
    },
    {
      "name":"Public jobs",
      "item":[
        {"name":"List jobs","request":{"method":"GET","url":"{{baseUrl}}/api/v1/jobs?location=Mumbai&limit=20"},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));"]}}]},
        {"name":"Invalid method","request":{"method":"TRACE","url":"{{baseUrl}}/api/v1/jobs"},"event":[{"listen":"test","script":{"exec":["pm.test('405 or 404',()=>pm.expect(pm.response.code).to.be.oneOf([404,405]));"]}}]}
      ]
    },
    {
      "name":"Recruiter",
      "item":[
        {"name":"Dashboard","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{recruiterJwt}}"}],"url":"{{baseUrl}}/api/v1/recruiter/dashboard"},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));"]}}]},
        {"name":"Create job","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{recruiterJwt}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"title\":\"QA Go Engineer\",\"description\":\"QA fixture\",\"employment_type\":\"full_time\",\"work_mode\":\"hybrid\",\"city\":\"Mumbai\",\"state\":\"Maharashtra\",\"country_code\":\"IN\",\"min_experience_months\":0,\"openings\":1,\"publish\":false}"},"url":"{{baseUrl}}/api/v1/recruiter/jobs"},"event":[{"listen":"test","script":{"exec":["pm.test('201',()=>pm.response.to.have.status(201));","if(pm.response.code===201){pm.collectionVariables.set('jobId', pm.response.json().id);}"]}}]},
        {"name":"Pipeline page","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{recruiterJwt}}"}],"url":"{{baseUrl}}/api/v1/recruiter/pipeline?page=1&limit=10"},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));","pm.test('bounded',()=>pm.expect(pm.response.json().items.length).to.be.at.most(10));"]}}]},
        {"name":"Move application stage","request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{recruiterJwt}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"stage\":\"interview\"}"},"url":"{{baseUrl}}/api/v1/recruiter/applications/{{applicationId}}/stage"},"event":[{"listen":"test","script":{"exec":["pm.test('204',()=>pm.response.to.have.status(204));"]}}]}
      ]
    },
    {
      "name":"Validation and security",
      "item":[
        {"name":"Malformed login JSON","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":"},"url":"{{baseUrl}}/api/v1/auth/login"},"event":[{"listen":"test","script":{"exec":["pm.test('400',()=>pm.response.to.have.status(400));"]}}]},
        {"name":"Candidate blocked from recruiter dashboard","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{candidateJwt}}"}],"url":"{{baseUrl}}/api/v1/recruiter/dashboard"},"event":[{"listen":"test","script":{"exec":["pm.test('403',()=>pm.response.to.have.status(403));"]}}]},
        {"name":"Candidate blocked from master admin","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{candidateJwt}}"}],"url":"{{baseUrl}}/api/v1/admin/recruiters/00000000-0000-0000-0000-000000000000/verify"},"event":[{"listen":"test","script":{"exec":["pm.test('403',()=>pm.response.to.have.status(403));"]}}]}
      ]
    }
  ]
}
