FROM golang:1.26-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/sapienworx-intelligence ./cmd/intelligence

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata     && addgroup -S sapienworx     && adduser -S -G sapienworx -H -s /sbin/nologin sapienworx
COPY --from=builder /out/sapienworx-intelligence /usr/local/bin/sapienworx-intelligence
USER sapienworx
ENTRYPOINT ["/usr/local/bin/sapienworx-intelligence"]
