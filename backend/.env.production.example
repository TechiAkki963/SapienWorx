# Reference only. Store real values in AWS Secrets Manager/ECS task definitions.
SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=jdbc:postgresql://production-db.internal:5432/sapienworx?sslmode=require
DATABASE_USERNAME=sapienworx_app
DATABASE_PASSWORD=from-aws-secrets-manager
REDIS_URL=rediss://production-cache.internal:6379
JWT_BASE64_SECRET=from-aws-secrets-manager
AUTH_COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=https://www.sapienworx.com

BACKGROUND_QUEUE_PROVIDER=sqs
AWS_REGION=ap-south-1
SQS_OTP_EMAIL_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/account/sapienworx-production-otp-email
SQS_OTP_MOBILE_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/account/sapienworx-production-otp-mobile
SQS_CV_CANDIDATE_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/account/sapienworx-production-cv-candidate
SQS_CV_BULK_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/account/sapienworx-production-cv-bulk
SQS_CV_DEAD_LETTER_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/account/sapienworx-production-cv-dlq
SQS_EMAIL_BULK_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/account/sapienworx-production-email-bulk
SQS_EMAIL_DEAD_LETTER_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/account/sapienworx-production-email-dlq

CV_STORAGE_TYPE=s3
CV_STORAGE_S3_BUCKET=sapienworx-production-cv-ACCOUNT_ID-ap-south-1
CV_STORAGE_S3_QUARANTINE_PREFIX=quarantine/candidates
CV_STORAGE_S3_KMS_KEY_ID=alias/sapienworx-production-data
CV_STORAGE_REQUIRE_CLEAN_SCAN_TAG=true

# API task: all false. Enable only the relevant group in dedicated worker tasks.
CV_WORKER_ENABLED=false
OTP_EMAIL_WORKER_ENABLED=false
OTP_MOBILE_WORKER_ENABLED=false
EMAIL_WORKER_ENABLED=false

SPRING_MAIL_HOST=email-smtp.ap-south-1.amazonaws.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=from-aws-secrets-manager
SPRING_MAIL_PASSWORD=from-aws-secrets-manager
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
AUTHENTICATION_EMAIL_FROM=security@sapienworx.com
COMMUNICATION_EMAIL_FROM=notifications@sapienworx.com

FLYWAY_ENABLED=false
PRIVACY_RETENTION_PURGE_ENABLED=false
