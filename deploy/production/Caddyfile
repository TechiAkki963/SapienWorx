{
	email {$ACME_EMAIL}
	admin off
}

http://127.0.0.1:2019 {
	respond /healthz 200
}

www.sapienworx.com {
	redir https://sapienworx.com{uri} permanent
}

sapienworx.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# SES remains sandboxed during the controlled public-testing phase. Keep
	# existing-account access available, but prevent arbitrary visitors from
	# starting email-dependent account and recovery flows that cannot complete.
	@restricted_email_flow {
		method POST
		path /api/v1/auth/candidate/register /api/v1/auth/recruiter/register /api/v1/auth/email/request /api/v1/auth/password/forgot
	}
	header @restricted_email_flow {
		Content-Type "application/json; charset=utf-8"
		Retry-After "86400"
	}
	respond @restricted_email_flow `{"error":{"code":"controlled_testing_only","message":"New account and recovery email requests are limited to approved testers during controlled testing."}}` 503

	@backend path /api/* /health/*
	reverse_proxy @backend backend:8080 {
		header_up X-Real-IP {remote_host}
	}

	reverse_proxy frontend:3000
}
