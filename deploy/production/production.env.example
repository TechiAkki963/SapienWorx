# This file is documentation only. The deployed runtime/production.env file is
# generated on EC2 from SSM Parameter Store with mode 0600.
ECR_REGISTRY=123456789012.dkr.ecr.ap-south-1.amazonaws.com
IMAGE_TAG=0123456789abcdef0123456789abcdef01234567
AWS_REGION=ap-south-1
S3_BUCKET=sapienworx-production-documents-ACCOUNT_ID-ap-south-1

# Never commit real values for these parameters.
DATABASE_URL=postgres://sapienworx_app:REDACTED@rds-endpoint:5432/sapienworx?sslmode=require
INTELLIGENCE_DATABASE_URL=postgres://sapienworx_intelligence:REDACTED@rds-endpoint:5432/sapienworx?sslmode=require
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
AUTH_OTP_HMAC_SECRET=REPLACE_WITH_A_DIFFERENT_32_BYTE_SECRET

# Non-secret edge controls live in runtime/deployment.conf on EC2.
CADDY_ENABLED=false
ACME_EMAIL=info@sapienworx.com

# P2.4 email delivery remains disabled until SES production access is separately approved.
EMAIL_DELIVERY_ENABLED=false
EMAIL_FROM_ADDRESS=info@sapienworx.com
EMAIL_WORKER_INTERVAL=5s
EMAIL_WORKER_BATCH_SIZE=10
EMAIL_MAX_ATTEMPTS=5
