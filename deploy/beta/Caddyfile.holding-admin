{
	email {$ACME_EMAIL}
	admin 127.0.0.1:2020
}

http://127.0.0.1:2019 {
	respond /healthz 200
}

sapienworx.com, www.sapienworx.com {
	root * /srv/holding
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
		-Server
	}
	@application path /api /api/* /health /health/*
	respond @application 404
	file_server
}
