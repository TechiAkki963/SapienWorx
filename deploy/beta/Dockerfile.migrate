FROM golang:1.26-alpine AS accounts
WORKDIR /src
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 go build -trimpath -o /out/sapienworx-beta-accounts ./cmd/beta-accounts

FROM postgres:17-alpine
COPY database/migrations /migrations
COPY database/migrate.sh /usr/local/bin/sapienworx-migrate
COPY deploy/beta/seed.sql /beta-seed.sql
COPY --from=accounts /out/sapienworx-beta-accounts /usr/local/bin/sapienworx-beta-accounts
RUN chmod 0555 /usr/local/bin/sapienworx-migrate
USER postgres
ENTRYPOINT ["/usr/local/bin/sapienworx-migrate"]
